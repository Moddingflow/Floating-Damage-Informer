{
  "version": 8,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "warnings": {
        "unusedCli": false
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "FDN_BUILD_SKSE_PLUGIN": "ON",
        "FDN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "warnings": {
        "unusedCli": false
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "FDN_BUILD_SKSE_PLUGIN": "ON",
        "FDN_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "tests",
      "displayName": "Core Tests Only",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "FDN_BUILD_SKSE_PLUGIN": "OFF",
        "FDN_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "tests-release",
      "configurePreset": "tests",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "tests-release",
      "configurePreset": "tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
